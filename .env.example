# Runtime URL: Neon pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"

# Direct Neon connection string, without the -pooler hostname; used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"

# Generate a unique random value for production. Do not reuse the development secret.
SESSION_SECRET="replace-with-a-long-random-secret"